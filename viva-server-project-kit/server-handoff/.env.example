# Viva Server configuration contract
# Copy to .env only for local development. Production uses Secret Manager/KMS and
# workload identity; do not place production secrets in environment variables.

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
VIVA_ENV=local
VIVA_ROLE=api
VIVA_REGION=local
VIVA_AZ=local-a
VIVA_INSTANCE_ID=local-1
VIVA_LOG_LEVEL=debug
VIVA_LOG_FORMAT=json
VIVA_HTTP_ADDR=:8080
VIVA_GATEWAY_ADDR=:8081
VIVA_METRICS_ADDR=:9090
# API/Worker default. Gateway overrides this to 90s for WebSocket drain.
VIVA_SHUTDOWN_GRACE=25s
VIVA_CONFIG_STRICT=true

# Public canonical URLs. DPoP htu validation depends on these exact values.
VIVA_API_BASE_URL=http://localhost:8080
VIVA_VOICE_BASE_URL=ws://localhost:8081
# RFC 9449 htu uses the HTTP(S) opening-handshake URI, not ws(s).
# Production example: https://voice.api.example.cn
VIVA_VOICE_DPOP_HTU_BASE_URL=http://localhost:8081
VIVA_ADMIN_BASE_URL=http://localhost:8082
# Direct-host local default. When an LB/Nginx container is introduced, replace
# this with its exact private subnet/address; never trust an entire VPC by habit.
VIVA_TRUSTED_PROXY_CIDRS=127.0.0.1/32

# ----------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------
# Role-local example. Compose overrides this per api/gateway/worker/migrate.
# Production injects four distinct credentials from Secret Manager.
VIVA_DATABASE_URL=postgres://viva_api:viva-api-local-only@postgres:5432/viva?sslmode=disable
VIVA_DATABASE_MAX_CONNS=20
VIVA_DATABASE_MIN_CONNS=2
VIVA_DATABASE_MAX_CONN_LIFETIME=30m
VIVA_DATABASE_QUERY_TIMEOUT=3s
VIVA_DATABASE_MIGRATIONS_DIR=/app/migrations

# ----------------------------------------------------------------------------
# Redis-compatible store (Valkey preferred for self-hosting)
# ----------------------------------------------------------------------------
VIVA_REDIS_ADDR=valkey:6379
VIVA_REDIS_USERNAME=
VIVA_REDIS_PASSWORD_FILE=
VIVA_REDIS_DB=0
VIVA_REDIS_TLS=false
VIVA_REDIS_POOL_SIZE=30
VIVA_REDIS_DIAL_TIMEOUT=500ms
VIVA_REDIS_READ_TIMEOUT=300ms
VIVA_REDIS_WRITE_TIMEOUT=300ms

# ----------------------------------------------------------------------------
# JWT, DPoP and encryption
# Local files contain generated test keys only. Production values are KMS refs.
# ----------------------------------------------------------------------------
VIVA_AUTH_ISSUER=http://localhost:8080
VIVA_AUTH_DESKTOP_AUDIENCE=viva-desktop
VIVA_AUTH_ADMIN_AUDIENCE=viva-admin
VIVA_ACCESS_TOKEN_TTL=10m
VIVA_REFRESH_TOKEN_TTL=720h
VIVA_REFRESH_FAMILY_MAX_TTL=2160h
VIVA_JWT_SIGNING_KEY_REF=local-file:/run/secrets/jwt_signing_key.pem
VIVA_JWT_VERIFICATION_JWKS_REF=local-file:/run/secrets/jwt_verification_jwks.json
VIVA_JWT_ACTIVE_KID=local-2026-01
# Optional only when previous verification keys are not already in the JWKS.
VIVA_JWT_PREVIOUS_PUBLIC_KEYS_DIR=
VIVA_REFRESH_TOKEN_PEPPER_REF=local-file:/run/secrets/refresh_pepper
VIVA_PII_HMAC_PEPPER_REF=local-file:/run/secrets/pii_hmac_pepper
VIVA_PII_KEK_REF=local-file:/run/secrets/local_pii_kek
VIVA_DPOP_REQUIRED=false
VIVA_DPOP_CLOCK_SKEW=60s
VIVA_DPOP_MAX_AGE=120s
VIVA_DPOP_REPLAY_TTL=5m

# Production admin authentication uses a separate enterprise OIDC provider.
VIVA_ADMIN_ENABLED=false
VIVA_ADMIN_OIDC_ISSUER=https://admin-idp.example.cn
VIVA_ADMIN_OIDC_AUDIENCE=viva-admin
VIVA_ADMIN_OIDC_JWKS_CACHE_TTL=15m

# ----------------------------------------------------------------------------
# Client compatibility and remote config
# ----------------------------------------------------------------------------
VIVA_PROTOCOL_VERSION=1
VIVA_MINIMUM_CLIENT_VERSION=0.0.0
VIVA_REMOTE_CONFIG_SIGNING_KEY_REF=local-file:/run/secrets/config_signing_key.pem
VIVA_REMOTE_CONFIG_CACHE_TTL=60s

# ----------------------------------------------------------------------------
# ASR Gateway
# ----------------------------------------------------------------------------
VIVA_ASR_UPSTREAM_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VIVA_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VIVA_ASR_SECRET_REF=local-file:/run/secrets/volc_asr_credentials.json
VIVA_ASR_UPSTREAM_CONNECT_TIMEOUT=3s
VIVA_ASR_FIRST_BINARY_TIMEOUT=2s
VIVA_ASR_INTERFRAME_IDLE_TIMEOUT=10s
VIVA_ASR_FINAL_TIMEOUT=8s
VIVA_ASR_DEFAULT_MAX_SESSION=50s
VIVA_ASR_HARD_MAX_SESSION=90s
VIVA_ASR_MAX_BINARY_MESSAGE_BYTES=131072
VIVA_ASR_MAX_FULL_REQUEST_INFLATED_BYTES=65536
VIVA_ASR_PREUPSTREAM_MAX_FRAMES=16
VIVA_ASR_PREUPSTREAM_MAX_BYTES=262144
VIVA_ASR_AUDIO_TOKEN_BUCKET_BYTES=131072
VIVA_ASR_AUDIO_REFILL_BYTES_PER_SECOND=65536
VIVA_ASR_PERMESSAGE_DEFLATE=false
VIVA_ASR_LOCAL_INSTANCE_SESSION_LIMIT=30
VIVA_ASR_GLOBAL_PROVIDER_LIMIT=50
VIVA_ASR_USER_TRAFFIC_LIMIT=45
VIVA_ASR_PROBE_RESERVED_CONCURRENCY=5
VIVA_ASR_LEASE_TTL=120s
VIVA_ASR_LEASE_HEARTBEAT=20s

# ----------------------------------------------------------------------------
# Trial and default entitlement
# ----------------------------------------------------------------------------
VIVA_TRIAL_ASR_AUDIO_MS=1800000
VIVA_TRIAL_LLM_INPUT_TOKENS=100000
VIVA_TRIAL_LLM_OUTPUT_TOKENS=20000
VIVA_TRIAL_MAX_ASR_CONCURRENCY=1
VIVA_TRIAL_MAX_SESSION_MS=50000
VIVA_TRIAL_REQUIRES_EMAIL_AFTER_AUDIO_MS=600000

# ----------------------------------------------------------------------------
# Rate limits
# ----------------------------------------------------------------------------
VIVA_RATE_BOOTSTRAP_IP_PER_HOUR=10
VIVA_RATE_BOOTSTRAP_GLOBAL_PER_DAY=10000
VIVA_RATE_OTP_EMAIL_PER_HOUR=5
VIVA_RATE_OTP_IP_PER_HOUR=20
VIVA_RATE_ASR_USER_PER_MINUTE=10
VIVA_RATE_ASR_USER_BURST=3
VIVA_RATE_ASR_IP_PER_MINUTE=30
VIVA_RATE_POLISH_USER_PER_MINUTE=30
VIVA_RATE_ADMIN_PER_MINUTE=120

# ----------------------------------------------------------------------------
# LLM / Volcengine Ark
# ----------------------------------------------------------------------------
VIVA_POLISH_ENABLED=true
VIVA_POLISH_PROVIDER=mock
VIVA_POLISH_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VIVA_POLISH_SECRET_REF=local-file:/run/secrets/volc_ark_credentials.json
VIVA_POLISH_FAST_MODEL_REF=endpoint-placeholder-fast
VIVA_POLISH_QUALITY_MODEL_REF=endpoint-placeholder-quality
VIVA_POLISH_PROMPT_DIR=/app/prompts
VIVA_POLISH_DEFAULT_PROMPT_VERSION=polish-v1
VIVA_POLISH_MAX_INPUT_CHARS=8000
VIVA_POLISH_HARD_MAX_INPUT_CHARS=16000
VIVA_POLISH_MAX_BODY_BYTES=65536
VIVA_POLISH_CONNECT_TIMEOUT=2s
VIVA_POLISH_FIRST_TOKEN_TIMEOUT=3s
VIVA_POLISH_TOTAL_TIMEOUT=8s
VIVA_POLISH_MAX_OUTPUT_TOKENS_FAST=512
VIVA_POLISH_MAX_OUTPUT_TOKENS_QUALITY=1024
VIVA_POLISH_RETRY_BEFORE_DELTA=1

# Optional internal LiteLLM. Keep disabled until multiple LLM providers are needed.
VIVA_LITELLM_ENABLED=false
VIVA_LITELLM_BASE_URL=http://litellm:4000
VIVA_LITELLM_VIRTUAL_KEY_FILE=/run/secrets/litellm_virtual_key

# ----------------------------------------------------------------------------
# Email OTP
# ----------------------------------------------------------------------------
VIVA_EMAIL_PROVIDER=mock
VIVA_EMAIL_FROM=no-reply@example.cn
VIVA_EMAIL_SECRET_REF=local-file:/run/secrets/email_provider_credentials.json
VIVA_EMAIL_SMTP_ADDR=
VIVA_EMAIL_SMTP_TLS_MODE=disabled
VIVA_EMAIL_SMTP_USERNAME=
VIVA_EMAIL_SMTP_PASSWORD_FILE=
VIVA_OTP_TTL=5m
VIVA_OTP_MAX_ATTEMPTS=5
VIVA_OTP_RESEND_INTERVAL=60s

# ----------------------------------------------------------------------------
# Billing
# ----------------------------------------------------------------------------
VIVA_BILLING_PROVIDER=mock
VIVA_BILLING_SECRET_REF=local-file:/run/secrets/billing_provider_credentials.json
VIVA_BILLING_WEBHOOK_MAX_BODY_BYTES=1048576
VIVA_BILLING_ORDER_TTL=30m
VIVA_BILLING_RECONCILIATION_INTERVAL=6h

# ----------------------------------------------------------------------------
# Privacy exports and diagnostics object storage
# ----------------------------------------------------------------------------
VIVA_OBJECT_STORE_PROVIDER=s3
VIVA_OBJECT_STORE_ENDPOINT=http://minio:9000
VIVA_OBJECT_STORE_REGION=local
VIVA_OBJECT_STORE_FORCE_PATH_STYLE=true
VIVA_OBJECT_STORE_BUCKET=viva-local
VIVA_OBJECT_STORE_SECRET_REF=local-file:/run/secrets/object_store_credentials.json
VIVA_PRIVACY_EXPORT_DOWNLOAD_TTL=10m
VIVA_PRIVACY_EXPORT_OBJECT_TTL=24h
VIVA_DIAGNOSTIC_UPLOAD_MAX_BYTES=10485760
VIVA_DIAGNOSTIC_OBJECT_TTL=48h
VIVA_ACCOUNT_DELETION_GRACE=168h

# ----------------------------------------------------------------------------
# Usage, outbox and reconciliation
# ----------------------------------------------------------------------------
VIVA_USAGE_COMMIT_TIMEOUT=3s
VIVA_USAGE_RETRY_MIN=1s
VIVA_USAGE_RETRY_MAX=5m
VIVA_USAGE_LEDGER_TARGET_LAG=60s
VIVA_OUTBOX_BATCH_SIZE=100
VIVA_OUTBOX_POLL_INTERVAL=500ms
VIVA_PROVIDER_RECONCILIATION_DAILY_AT=03:30

# ----------------------------------------------------------------------------
# Cost budgets and automatic circuit breakers
# Amounts are integer micro-yuan or provider-specific integer micro currency.
# ----------------------------------------------------------------------------
VIVA_DAILY_COST_BUDGET_MICRO=1000000000
VIVA_COST_WARN_RATIO=0.70
VIVA_COST_RESTRICT_TRIAL_RATIO=0.85
VIVA_COST_STOP_TRIAL_RATIO=0.95
VIVA_COST_HARD_STOP_RATIO=1.00

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
OTEL_SERVICE_NAME=viva-server
# Local default avoids a dangling exporter. Production/staging must set false
# and configure a reachable private Collector.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
VIVA_TRACE_SUCCESS_SAMPLE_RATIO=0.01
VIVA_TRACE_ERROR_SAMPLE_RATIO=1.0
VIVA_TRACE_SLOW_SESSION_THRESHOLD=2s
VIVA_METRICS_HIGH_CARDINALITY_GUARD=true
VIVA_LOG_CONTENT_FIELDS=false
VIVA_LOG_AUTH_HEADERS=false
